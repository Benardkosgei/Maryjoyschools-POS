# Production Environment Example
APP_NAME="MARYJOY SCHOOLS INVENTORY"
APP_ENV=production
APP_KEY=base64:your-production-key-here
APP_DEBUG=false
APP_URL=https://inventory.maryjoyschools.com

APP_TIMEZONE="Africa/Nairobi"

# Production Database Settings (UPDATE THESE)
DB_CONNECTION=mysql
DB_HOST=localhost  # or your production DB host
DB_PORT=3306
DB_DATABASE=your_production_database_name
DB_USERNAME=your_production_db_user
DB_PASSWORD=your_production_db_password

# Other settings...
DUMP_PATH=mysqldump
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120